// Loom Dashboard v2 - Three.js 3D charts + SSE real-time
const COLORS = { ok: 0x34d399, warn: 0xf59e0b, err: 0xf472b6, info: 0x22d3ee, accent: 0x60a5fa, grid: 0x263042, text: 0x8a94a6, surface: 0x1e232b, bg: 0x0b0c10, panel: 0x161a20 };
let es = null, lastEvent = 0;
const scenes = {}, renderers = {}, cameras = {}, meshes = {};
function $(id) { return document.getElementById(id); }
function connect() {
  if (es) { try { es.close(); } catch(e){} }
  es = new EventSource('/api/stream');
  es.onopen = function() { $('status-pill').className = 'pill pill--live'; $('status-pill').textContent = 'LIVE'; };
  es.onerror = function() { $('status-pill').className = 'pill pill--dead'; $('status-pill').textContent = 'disconnected'; setTimeout(connect, 1500); };
  es.onmessage = function(e) { lastEvent = Date.now(); render(JSON.parse(e.data)); };
}
setInterval(function() { if (lastEvent && Date.now() - lastEvent > 5000) { $('status-pill').className = 'pill pill--dead'; $('status-pill').textContent = 'stale'; } }, 1000);
setInterval(fetchSnapshot, 3000);
function init3D() {
  if (typeof THREE === 'undefined') { console.warn('Three.js not loaded, retrying...'); setTimeout(init3D, 100); return; }
  initChart('chart-calls', 'bar3d');
  initChart('chart-lat', 'line3d');
  initChart('chart-issues', 'donut3d');
  animate();
  fetchSnapshot();
}
function fetchSnapshot() {
  fetch('/api/snapshot').then(function(r) { return r.json(); }).then(function(s) { render(s); }).catch(function(e) { console.error('snapshot failed', e); });
}
function initChart(containerId, type) {
  const container = $(containerId);
  if (!container) return;
  const rect = container.getBoundingClientRect();
  const width = rect.width || 400, height = rect.height || 280;
  const canvas = document.createElement('canvas');
  canvas.style.width = '100%';
  canvas.style.height = '100%';
  canvas.style.display = 'block';
  container.appendChild(canvas);
  const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
  renderer.setSize(width, height);
  renderer.setPixelRatio(window.devicePixelRatio || 1);
  renderers[containerId] = renderer;
  const scene = new THREE.Scene();
  scenes[containerId] = scene;
  const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
  camera.position.set(0, 15, 25);
  camera.lookAt(0, 0, 0);
  cameras[containerId] = camera;
  const ambient = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambient);
  const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
  dirLight.position.set(10, 20, 15);
  scene.add(dirLight);
  const fillLight = new THREE.DirectionalLight(0x60a5fa, 0.3);
  fillLight.position.set(-10, 10, -15);
  scene.add(fillLight);
  const gridHelper = new THREE.GridHelper(30, 30, COLORS.grid, COLORS.grid);
  gridHelper.position.y = -1.5;
  scene.add(gridHelper);
  meshes[containerId] = { type: type, bars: [], lines: [], labels: [] };
  updateChartOverlay(containerId);
}
function updateChartOverlay(id) { /* placeholder for HTML labels */ }
function animate() {
  requestAnimationFrame(animate);
  Object.keys(scenes).forEach(function(id) {
    const renderer = renderers[id], scene = scenes[id], camera = cameras[id];
    if (renderer && scene && camera) { scene.rotation.y += 0.0003; renderer.render(scene, camera); }
  });
}
function render(snap) {
  if (!snap) return;
  $('last-update').textContent = new Date(snap.ts*1000).toLocaleTimeString();
  const db = snap.db || {}, a = snap.audit || {};
  const kpis = [
    ['Sessions', db.sessions || '—'], ['Chunks', db.chunks || '—'], ['Sources', db.sources || '—'],
    ['Anchors', db.anchors || '—'], ['Invariants', db.invariants || '—'],
    ['DB size', fmt(db.size_bytes)], ['Calls/min', a.calls_per_min || 0],
    ['Error rate', ((a.error_rate||0)*100).toFixed(1)+'%'], ['p50 ms', a.p50 || 0],
    ['p95 ms', a.p95 || 0], ['Saved %', ((db.saved_ratio||0)*100).toFixed(1)+'%']
  ];
  $('kpi-row').innerHTML = kpis.map(function(kv) { return '<div class="kpi-card"><div class="kpi-label">'+kv[0]+'</div><div class="kpi-value">'+kv[1]+'</div></div>'; }).join('');
  updateBar3D(a);
  updateLine3D(a);
  updateDonut3D(db);
  renderEvents(a.recent_events || []);
}
function fmt(b) { if (!b) return '—'; if (b < 1024) return b+' B'; if (b < 1048576) return (b/1024).toFixed(1)+' KB'; return (b/1048576).toFixed(1)+' MB'; }
function updateBar3D(a) {
  const id = 'chart-calls';
  const m = meshes[id]; if (!m) return;
  const scene = scenes[id]; if (!scene) return;
  m.bars.forEach(function(b) { scene.remove(b); }); m.bars = [];
  m.labels.forEach(function(l) { scene.remove(l); }); m.labels = [];
  let tools = a.series_tools || [], counts = a.series_counts || {}, labels = a.series_labels || [];
  if (!tools.length) {
    const evs = (a.recent_events || []).slice(0, 15).reverse();
    if (!evs.length) return;
    const byTool = {};
    evs.forEach(function(e) { const t = e.tool || 'unknown'; byTool[t] = (byTool[t] || 0) + 1; });
    tools = Object.keys(byTool);
    counts = {};
    tools.forEach(function(t) { counts[t] = evs.map(function(e) { return (e.tool === t) ? byTool[t] : 0; }); });
    labels = evs.map(function(e, i) { return '#' + (i + 1); });
  }
  if (!tools.length || !labels.length) return;
  const maxCount = Math.max(1, ...tools.map(function(t) { return Math.max(...(counts[t] || [0])); }));
  const barWidth = 1.2, spacing = 1.8, startX = -(tools.length - 1) * spacing / 2;
  tools.forEach(function(tool, ti) {
    const data = counts[tool] || [], color = getColor(ti), x = startX + ti * spacing;
    data.forEach(function(val, i) {
      const height = (val / maxCount) * 12;
      const geometry = new THREE.BoxGeometry(barWidth, height, barWidth);
      const material = new THREE.MeshPhongMaterial({ color, transparent: true, opacity: 0.9, shininess: 100 });
      const bar = new THREE.Mesh(geometry, material);
      bar.position.set(x, height/2 - 1.5, i * spacing - (labels.length-1)*spacing/2);
      bar.userData = { tool, value: val, time: labels[i] };
      scene.add(bar); m.bars.push(bar);
    });
  });
}
function updateLine3D(a) {
  const id = 'chart-lat';
  const m = meshes[id]; if (!m) return;
  const scene = scenes[id]; if (!scene) return;
  m.lines.forEach(function(l) { scene.remove(l); }); m.lines = [];
  const labels = a.latency_series_labels || [];
  const p50raw = a.latency_p50_series || [], p95raw = a.latency_p95_series || [];
  const clean = function(arr) { return arr.map(function(v) { return (v === null || v === undefined || isNaN(v)) ? 0 : Number(v); }); };
  const p50 = clean(p50raw), p95 = clean(p95raw);
  if (!labels.length) return;
  const maxVal = Math.max(1, ...p50, ...p95);
  const spacing = 30 / (labels.length - 1 || 1), startX = -15;
  [{data: p50, color: COLORS.accent, name: 'p50'}, {data: p95, color: COLORS.warn, name: 'p95'}].forEach(function(series, si) {
    const points = series.data.map(function(val, i) { return new THREE.Vector3(startX + i * spacing, (val / maxVal) * 10 - 1.5, si === 0 ? -2 : 2); });
    const curve = new THREE.CatmullRomCurve3(points);
    const tubeGeo = new THREE.TubeGeometry(curve, points.length * 4, 0.25, 8, false);
    const tubeMat = new THREE.MeshPhongMaterial({ color: series.color, transparent: true, opacity: 0.8 });
    const tube = new THREE.Mesh(tubeGeo, tubeMat);
    scene.add(tube); m.lines.push(tube);
    points.forEach(function(p, i) {
      const sphereGeo = new THREE.SphereGeometry(0.35, 12, 12);
      const sphereMat = new THREE.MeshPhongMaterial({ color: series.color, emissive: series.color, emissiveIntensity: 0.3 });
      const sphere = new THREE.Mesh(sphereGeo, sphereMat);
      sphere.position.copy(p);
      sphere.userData = { series: series.name, value: series.data[i], time: labels[i] };
      scene.add(sphere); m.lines.push(sphere);
    });
  });
}
function updateDonut3D(db) {
  const id = 'chart-issues';
  const m = meshes[id]; if (!m) return;
  const scene = scenes[id]; if (!scene) return;
  m.bars.forEach(function(b) { scene.remove(b); }); m.bars = [];
  m.labels.forEach(function(l) { scene.remove(l); }); m.labels = [];
  const kinds = (db.invariants_by_kind || []).slice(0, 8);
  if (!kinds.length) return;
  const total = kinds.reduce(function(s, k) { return s + (k.n || 0); }, 0);
  if (total === 0) return;
  let startAngle = -Math.PI/2, radius = 6, thickness = 2.5;
  kinds.forEach(function(kind, i) {
    const angle = (kind.n / total) * Math.PI * 2;
    const color = Object.values(COLORS)[i % 8];
    const geo = new THREE.TorusGeometry(radius, thickness, 16, 32, angle);
    const mat = new THREE.MeshPhongMaterial({ color, transparent: true, opacity: 0.9, side: THREE.DoubleSide });
    const mesh = new THREE.Mesh(geo, mat);
    mesh.rotation.x = -Math.PI/2; mesh.rotation.z = startAngle; mesh.position.y = -1.5;
    mesh.userData = { kind: kind.kind, count: kind.n, pct: ((kind.n/total)*100).toFixed(1) };
    scene.add(mesh); m.bars.push(mesh);
    startAngle += angle;
  });
  const centerGeo = new THREE.RingGeometry(0, radius - thickness, 32);
  const centerMat = new THREE.MeshBasicMaterial({ color: COLORS.panel, side: THREE.DoubleSide });
  const center = new THREE.Mesh(centerGeo, centerMat);
  center.rotation.x = -Math.PI/2; center.position.y = -1.4;
  scene.add(center); m.bars.push(center);
}
function renderEvents(evs) {
  const tb = $('events-tbody'); if (!tb) return;
  tb.innerHTML = evs.slice(0,50).map(function(e) {
    const ok = !(e.outcome||'').toLowerCase().includes('err');
    return '<tr><td>'+(e.tool||'')+'</td><td>'+(e.session_id||'')+'</td><td><span class="status-badge '+(ok?'ok':'err')+'">'+(e.outcome||'')+'</span></td><td class="mono">'+(e.latency_ms||0)+' ms</td><td class="small">'+(e.ts||'')+'</td></tr>';
  }).join('');
}
function getColor(i) { const colors = [COLORS.accent, COLORS.ok, COLORS.warn, COLORS.info, COLORS.err, 0xa78bfa, 0xf472b6, 0x22d3ee]; return colors[i % colors.length]; }
window.addEventListener('resize', function() {
  Object.keys(renderers).forEach(function(id) {
    const canvas = $(id);
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const renderer = renderers[id], camera = cameras[id];
    if (renderer && camera) { renderer.setSize(rect.width, rect.height); camera.aspect = rect.width / rect.height; camera.updateProjectionMatrix(); }
  });
});
function loadThreeJS() {
  if (typeof THREE !== 'undefined') { init3D(); return; }
  const script = document.createElement('script');
  script.src = '/static/three.min.js';
  script.onload = init3D;
  script.onerror = function() { console.error('Three.js failed to load'); setTimeout(loadThreeJS, 2000); };
  document.head.appendChild(script);
}
document.addEventListener('DOMContentLoaded', function() { connect(); loadThreeJS(); });
document.addEventListener('visibilitychange', function() { if (document.hidden && es) es.close(); else connect(); });
