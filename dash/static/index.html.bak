<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>loom-dash</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/style.css" />
</head>
<body>
<div class="bg-grid"></div>
<div class="bg-glow a"></div>
<div class="bg-glow b"></div>
<div class="bg-glow c"></div>
<div class="bg-noise"></div>
<div class="topbar">
  <div class="left">
    <h1>loom-dash</h1>
    <span id="demo-badge" class="demo-badge" style="display:none">DEMO</span>
    <span id="status-pill" class="status-pill info">connecting…</span>
    <span id="stale-pill" class="status-pill stale" style="display:none">stale</span>
  </div>
  <div class="small mono" id="last-update">—</div>
</div>

<div id="error-banner" class="error" style="display:none"></div>

<div class="kpi-grid" id="kpi-grid"></div>

<div class="charts-grid">
  <div class="panel">
    <h2>Calls/min per tool (15 min)</h2>
    <svg class="chart" id="chart-calls" viewBox="0 0 400 180" preserveAspectRatio="none"></svg>
    <div class="legend" id="legend-calls"></div>
  </div>
  <div class="panel">
    <h2>Latency p50/p95 (ms)</h2>
    <svg class="chart" id="chart-lat" viewBox="0 0 400 180" preserveAspectRatio="none"></svg>
    <div class="legend" id="legend-lat"></div>
  </div>
  <div class="panel">
    <h2>Outcomes</h2>
    <svg class="chart" id="chart-outcomes" viewBox="0 0 400 180" preserveAspectRatio="none"></svg>
  </div>
  <div class="panel">
    <h2>Tokens before/after per store</h2>
    <svg class="chart" id="chart-tokens" viewBox="0 0 400 180" preserveAspectRatio="none"></svg>
    <div class="small">saved ratio (anchor only, excludes chunk_ids tokens): <span class="mono" id="saved-ratio">—</span></div>
  </div>
  <div class="panel">
    <h2>Invariants by kind</h2>
    <div id="invariants-bars"></div>
  </div>
  <div class="panel">
    <h2>Hits per session (includes ctx_verify reads)</h2>
    <div id="hits-bars"></div>
  </div>
</div>

<div class="panel">
  <h2>Recent events</h2>
  <div style="overflow:auto; max-height:320px;">
    <table class="data" id="events-table">
      <thead><tr><th>tool</th><th>session</th><th>outcome</th><th>latency ms</th><th>ts</th></tr></thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<div class="panel panel-3d">
  <h2>Chunk map (3D)</h2>
  <label class="toggle"><input type="checkbox" id="toggle-3d" /> enable 3D</label>
  <canvas id="canvas-3d" style="display:none"></canvas>
  <div id="scatter-2d"></div>
  <div class="small" id="webgl-status"></div>
</div>

<script src="/static/three.min.js"></script>
<script src="/static/app.js"></script>
</body>
</html>
