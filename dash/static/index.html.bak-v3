<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Loom · Context Observability</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css" />
</head>
<body>
  <!-- ambient glow orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <div class="shell">
    <!-- ============ SIDEBAR ============ -->
    <aside class="sidebar">
      <div class="brand">
        <div class="mark"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 4h6a4 4 0 0 1 0 8H4z M4 12h7a4 4 0 0 1 0 8H4z" fill="none" stroke="#04101e" stroke-width="2.4" stroke-linejoin="round"/></svg></div>
        <div class="brand-txt">
          <div class="brand-name">Loom</div>
          <div class="brand-sub">Context MCP</div>
        </div>
      </div>

      <nav class="nav">
        <button class="nav-item active" data-section="overview"><span class="nav-ico">▤</span> Overview</button>
        <button class="nav-item" data-section="storage"><span class="nav-ico">🗄</span> Storage</button>
        <button class="nav-item" data-section="audit"><span class="nav-ico">📡</span> Audit Live</button>
        <button class="nav-item" data-section="invariants"><span class="nav-ico">◈</span> Invariants</button>
        <button class="nav-item" data-section="sessions"><span class="nav-ico">⌁</span> Sessions</button>
      </nav>

      <div class="side-status">
        <div class="ss-row"><span class="ss-dot" id="stream-dot"></span><span id="stream-state">connecting…</span></div>
        <div class="ss-meta">
          <div><span class="ss-k">updated</span> <span class="ss-v mono" id="ss-updated">—</span></div>
          <div><span class="ss-k">db</span> <span class="ss-v mono" id="ss-db" title="">—</span></div>
          <div><span class="ss-k">events</span> <span class="ss-v mono" id="ss-events">—</span></div>
        </div>
      </div>

      <div class="side-actions">
        <button class="side-btn" id="btn-pause" title="Pause / Resume live stream">
          <span class="sb-ico" id="pause-ico">⏸</span><span id="pause-txt">Pause</span>
        </button>
        <button class="side-btn" id="btn-refresh" title="Refresh snapshot">
          <span class="sb-ico">↻</span> Refresh
        </button>
        <button class="side-btn" id="btn-reconnect" title="Reconnect stream">
          <span class="sb-ico">⟳</span> Reconnect
        </button>
        <button class="side-btn" id="btn-export" title="Export snapshot JSON">
          <span class="sb-ico">⤓</span> Export
        </button>
      </div>

      <div class="side-foot">v3.0 · read-only</div>
    </aside>

    <!-- ============ MAIN ============ -->
    <main class="main">
      <header class="topbar">
        <div class="tb-left">
          <h1 class="tb-title" id="tb-title">Overview</h1>
          <span class="tb-sub" id="tb-sub">Real-time context cache observability</span>
        </div>
        <div class="tb-right">
          <span class="pill" id="status-pill"><span class="pill-dot"></span><span id="pill-txt">LIVE</span></span>
          <span class="pill pill-quiet" id="rate-pill">— evt/min</span>
        </div>
      </header>

      <div class="content" id="content">
        <!-- ===== OVERVIEW ===== -->
        <section class="view view-active" id="view-overview">
          <div class="kpi-grid" id="kpi-grid"></div>
          <div class="grid-2">
            <div class="panel">
              <div class="panel-head"><h3>Appels par outil <span class="ph-sub">15 min</span></h3><span class="chip" id="calls-total">0</span></div>
              <div class="panel-body"><canvas id="chart-calls" class="cv"></canvas></div>
            </div>
            <div class="panel">
              <div class="panel-head"><h3>Latence p50 / p95 <span class="ph-sub">ms</span></h3><span class="chip" id="lat-max">—</span></div>
              <div class="panel-body"><canvas id="chart-lat" class="cv"></canvas></div>
            </div>
          </div>
          <div class="panel">
            <div class="panel-head"><h3>Derniers événements</h3>
              <div class="search"><span class="search-ico">⌕</span><input type="text" id="event-search" placeholder="Filtrer (outil, session, statut)…" /></div>
            </div>
            <div class="table-wrap"><table class="data-table"><thead><tr>
              <th>Heure</th><th>Outil</th><th>Session</th><th>Statut</th><th>Durée</th>
            </tr></thead><tbody id="events-tbody"></tbody></table></div>
          </div>
        </section>

        <!-- ===== STORAGE ===== -->
        <section class="view" id="view-storage">
          <div class="kpi-grid" id="store-kpi"></div>
          <div class="grid-2">
            <div class="panel">
              <div class="panel-head"><h3>Tokens par source <span class="ph-sub">avant → ancré</span></h3><span class="chip" id="saved-chip">—</span></div>
              <div class="panel-body"><canvas id="chart-tokens" class="cv"></canvas></div>
            </div>
            <div class="panel">
              <div class="panel-head"><h3>Carte des chunks <span class="ph-sub">heat = hits</span></h3><span class="chip" id="chunks-chip">0</span></div>
              <div class="panel-body"><canvas id="chart-chunkmap" class="cv"></canvas></div>
            </div>
          </div>
          <div class="panel">
            <div class="panel-head"><h3>Sources stockées</h3><span class="chip" id="src-count">0</span></div>
            <div class="table-wrap"><table class="data-table"><thead><tr>
              <th>ID</th><th>Label</th><th>Tokens avant</th><th>Tokens ancré</th><th>Économie</th>
            </tr></thead><tbody id="sources-tbody"></tbody></table></div>
          </div>
        </section>

        <!-- ===== AUDIT ===== -->
        <section class="view" id="view-audit">
          <div class="kpi-grid" id="audit-kpi"></div>
          <div class="grid-2">
            <div class="panel">
              <div class="panel-head"><h3>Appels par outil <span class="ph-sub">/ min · stacked</span></h3><span class="chip">15 min</span></div>
              <div class="panel-body"><canvas id="chart-calls2" class="cv"></canvas></div>
            </div>
            <div class="panel">
              <div class="panel-head"><h3>Latence p50 / p95 <span class="ph-sub">ms / min</span></h3><span class="chip" id="lat2-chip">—</span></div>
              <div class="panel-body"><canvas id="chart-lat2" class="cv"></canvas></div>
            </div>
          </div>
          <div class="grid-2">
            <div class="panel">
              <div class="panel-head"><h3>Outcomes <span class="ph-sub">60 s</span></h3></div>
              <div class="panel-body"><canvas id="chart-outcomes" class="cv"></canvas></div>
            </div>
            <div class="panel">
              <div class="panel-head"><h3>Journal d'événements</h3>
                <div class="search"><span class="search-ico">⌕</span><input type="text" id="audit-search" placeholder="Filtrer…" /></div>
              </div>
              <div class="table-wrap tall"><table class="data-table"><thead><tr>
                <th>Heure</th><th>Outil</th><th>Session</th><th>Statut</th><th>Durée</th>
              </tr></thead><tbody id="audit-tbody"></tbody></table></div>
            </div>
          </div>
        </section>

        <!-- ===== INVARIANTS ===== -->
        <section class="view" id="view-invariants">
          <div class="kpi-grid" id="inv-kpi"></div>
          <div class="grid-2">
            <div class="panel">
              <div class="panel-head"><h3>Répartition par type</h3><span class="chip" id="inv-total">0</span></div>
              <div class="panel-body"><canvas id="chart-inv" class="cv"></canvas></div>
            </div>
            <div class="panel">
              <div class="panel-head"><h3>Détail</h3></div>
              <div class="table-wrap"><table class="data-table"><thead><tr><th>Type</th><th>Count</th><th>Part</th></tr></thead><tbody id="inv-tbody"></tbody></table></div>
            </div>
          </div>
        </section>

        <!-- ===== SESSIONS ===== -->
        <section class="view" id="view-sessions">
          <div class="panel">
            <div class="panel-head"><h3>Hits par session</h3><span class="chip" id="sess-chip">0</span></div>
            <div class="panel-body"><canvas id="chart-sessions" class="cv"></canvas></div>
          </div>
          <div class="panel">
            <div class="panel-head"><h3>Toutes les sessions</h3></div>
            <div class="table-wrap"><table class="data-table"><thead><tr><th>Session</th><th>Hits</th></tr></thead><tbody id="sess-tbody"></tbody></table></div>
          </div>
        </section>
      </div>

      <footer class="foot">
        <span class="mono" id="last-update">—</span>
        <span class="divider">·</span>
        <span class="mono" id="db-info">—</span>
        <span class="foot-spacer"></span>
        <span class="mono">loom-dash v3.0</span>
      </footer>
    </main>
  </div>

  <div class="toast" id="toast"></div>
  <script src="/static/app.js"></script>
</body>
</html>
