/* atmosphere (QadGraph-style) */
.bg-grid { position: fixed; inset: 0; z-index: 0; pointer-events: none; background-image: linear-gradient(rgba(34, 211, 238, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(34, 211, 238, 0.035) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, #000 20%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, #000 20%, transparent 100%); }
.bg-glow { position: fixed; z-index: 0; pointer-events: none; border-radius: 50%; filter: blur(120px); opacity: 0.18; }
.bg-glow.a { width: 520px; height: 520px; background: #22d3ee; top: -220px; right: -160px; }
.bg-glow.b { width: 460px; height: 460px; background: #a855f7; bottom: -200px; left: -140px; }
.bg-glow.c { width: 360px; height: 360px; background: #10b981; top: 45%; left: 42%; opacity: 0.07; }
.bg-noise { position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0.35; background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0 3px, rgba(0,0,0,0.20) 4px); mix-blend-mode: multiply; }
body { position: relative; z-index: 2; }

:root {
  /* QadGraph-inspired: dark glass, sober accents (muted, no neon glow) */
  --bg: #070b14;
  --surface: rgba(12, 18, 32, 0.78);
  --surface2: rgba(20, 28, 46, 0.55);
  --border: rgba(120, 160, 210, 0.12);
  --text: #e6efff;
  --muted: #8fa2c2;
  --ok: #34d399;
  --warn: #f59e0b;
  --err: #f43f5e;
  --info: #60a5fa;
  --cyan: #22d3ee;
  --violet: #a855f7;
  --emerald: #10b981;
  --amber: #f59e0b;
  --rose: #f43f5e;
  --blue: #60a5fa;
  --s1: #22d3ee;
  --s2: #a855f7;
  --s3: #10b981;
  --s4: #f59e0b;
  --s5: #60a5fa;
  --s6: #f43f5e;
  --s7: #ec4899;
  --radius-sm: 6px;
  --radius-md: 10px;
  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;
  --sp-5: 24px;
  --sp-6: 32px;
  --t-fast: 120ms;
  --t-med: 200ms;
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'Cascadia Code', Consolas, monospace;
}

@media (prefers-color-scheme: light) {
  :root {
    --bg: #F6F8FA;
    --surface: #FFFFFF;
    --surface2: #EEF2F7;
    --border: #D0D7DE;
    --text: #1F2328;
    --muted: #57606A;
  }
}

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { background: var(--bg); color: var(--text); font-family: var(--font-sans); font-size: 14px; line-height: 1.4; }
body { background: var(--bg); color: var(--text); font-family: var(--font-sans); font-size: 14px; line-height: 1.4; padding: var(--sp-4); }

h1 { font-size: 28px; font-weight: 600; }
h2 { font-size: 20px; font-weight: 600; margin-bottom: var(--sp-3); }
h3 { font-size: 16px; font-weight: 600; }
.small { font-size: 12px; color: var(--muted); }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

.status-pill { display: inline-flex; align-items: center; gap: var(--sp-1); padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; border: 1px solid var(--border); }
.status-pill.ok { color: var(--ok); border-color: var(--ok); }
.status-pill.warn { color: var(--warn); border-color: var(--warn); }
.status-pill.err { color: var(--err); border-color: var(--err); }
.status-pill.info { color: var(--info); border-color: var(--info); }
.status-pill.stale { color: var(--warn); border-color: var(--warn); animation: pulse 1s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }

.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--sp-3); margin-bottom: var(--sp-5); }
.kpi-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--sp-3); backdrop-filter: blur(12px); }
.kpi-card .label { font-size: 12px; color: var(--muted); margin-bottom: var(--sp-1); }
.kpi-card .value { font-size: 28px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 600; }
.kpi-card .sub { font-size: 11px; color: var(--muted); margin-top: var(--sp-1); }

.panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--sp-4); margin-bottom: var(--sp-4); backdrop-filter: blur(12px); }
.panel h2 { margin-bottom: var(--sp-3); }

.charts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: var(--sp-4); }

table.data { width: 100%; border-collapse: collapse; font-size: 13px; }
table.data th, table.data td { padding: var(--sp-2); border-bottom: 1px solid var(--border); text-align: left; }
table.data th { color: var(--muted); font-weight: 600; font-size: 12px; }
table.data tr:hover { background: var(--surface2); }

.bar-row { display: flex; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-1); }
.bar-row .bar-label { width: 120px; font-size: 12px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-row .bar-track { flex: 1; height: 14px; background: var(--surface2); border-radius: var(--radius-sm); overflow: hidden; }
.bar-row .bar-fill { height: 100%; background: var(--info); transition: width var(--t-med); }
.bar-row .bar-val { width: 60px; text-align: right; font-family: var(--font-mono); font-size: 12px; }

.demo-badge { background: var(--warn); color: #000; padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 700; margin-left: var(--sp-2); }

.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-4); flex-wrap: wrap; gap: var(--sp-2); }
.topbar .left { display: flex; align-items: center; gap: var(--sp-2); }

.panel-3d { position: relative; }
.panel-3d canvas { width: 100%; height: 360px; display: block; background: var(--surface2); border-radius: var(--radius-sm); }
.panel-3d .toggle { position: absolute; top: var(--sp-2); right: var(--sp-2); }

.empty { color: var(--muted); font-size: 13px; padding: var(--sp-3); text-align: center; }
.error { color: var(--err); font-size: 13px; padding: var(--sp-3); }
.greyed { opacity: 0.4; pointer-events: none; }

svg.chart { width: 100%; height: 180px; }
svg.chart text { fill: var(--muted); font-size: 10px; }

.legend { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-2); font-size: 12px; }
.legend-item { display: flex; align-items: center; gap: 4px; }
.legend-swatch { width: 12px; height: 12px; border-radius: 2px; }
