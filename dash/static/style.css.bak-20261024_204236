/* ===== Loom Dashboard v2 ===== */
@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..2');
:root {
  --bg: #0b0c10;
  --surface: #161a20;
  --surface-hover: #1e232b;
  --border: #242a33;
  --border-hover: #3a4150;
  --text: #e8eaed;
  --text-muted: #8a94a6;
  --text-dim: #5c6676;
  --accent: #60a5fa;
  --accent-hover: #3b82f6;
  --ok: #34d399;
  --ok-dim: #10b981;
  --warn: #f59e0b;
  --warn-dim: #d97706;
  --err: #f472b6;
  --err-dim: #db2777;
  --info: #22d3ee;
  --chart-grid: #1e232b;
  --radius: 10px;
  --shadow: 0 1px 3px rgba(0,0,0,0.3), 0 1px 2px rgba(0,0,0,0.2);
  --shadow-lg: 0 10px 30px -10px rgba(0,0,0,0.5);
  --trans: 150ms ease;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 13px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
.material-symbols-outlined {
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  font-display: block;
  display: inline-block;
  vertical-align: middle;
}
.shell { display: flex; flex-direction: column; height: 100vh; }
.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
  padding: 0 24px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.brand { display: flex; align-items: center; gap: 12px; }
.mark {
  width: 28px; height: 28px;
  background: linear-gradient(135deg, var(--accent), var(--info));
  border-radius: 7px;
  display: grid; place-items: center;
  color: #050507;
  font-weight: 700; font-size: 16px; letter-spacing: -0.5px;
}
.title .name { font-weight: 600; font-size: 15px; letter-spacing: -0.2px; }
.title .sub { font-size: 11px; color: var(--text-muted); }
.actions { display: flex; align-items: center; gap: 10px; }
.icon-btn {
  width: 32px; height: 32px;
  border: 1px solid var(--border);
  background: var(--surface-hover);
  color: var(--text-muted);
  border-radius: 6px;
  cursor: pointer;
  display: grid; place-items: center;
  font-size: 16px;
  transition: all var(--trans);
}
.icon-btn:hover { background: var(--border); color: var(--text); border-color: var(--border-hover); }
.select {
  height: 32px;
  border: 1px solid var(--border);
  background: var(--surface-hover);
  color: var(--text);
  border-radius: 6px;
  padding: 0 8px;
  font-size: 12px; font-family: inherit;
  outline: none;
  cursor: pointer;
}
.select:hover { border-color: var(--border-hover); }
.pill {
  display: inline-flex; align-items: center;
  height: 20px; padding: 0 8px;
  border-radius: 10px;
  font-size: 11px; font-weight: 600;
  letter-spacing: 0.2px;
}
.pill--live {
  background: rgba(16,185,129,0.12);
  color: var(--ok);
  border: 1px solid rgba(16,185,129,0.25);
}
.pill--dead {
  background: rgba(244,114,182,0.12);
  color: var(--err);
  border: 1px solid rgba(244,114,182,0.25);
}
main { flex: 1; overflow-y: auto; padding: 24px; }
.grid { display: grid; gap: 16px; }
.kpi-row { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
.charts-row { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
.tables-row { grid-template-columns: 1fr; }
.kpi-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px;
  position: relative;
  overflow: hidden;
}
.kpi-card::before {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 100%);
  pointer-events: none;
}
.kpi-label {
  font-size: 11px; font-weight: 600; letter-spacing: 0.4px;
  color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px;
}
.kpi-value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 26px; font-weight: 700; line-height: 1.1;
  color: var(--text);
}
.kpi-delta {
  display: inline-flex; align-items: center; gap: 6px;
  margin-top: 8px; font-size: 11px; font-weight: 600;
}
.kpi-delta.ok { color: var(--ok); }
.kpi-delta.err { color: var(--err); }
.kpi-delta.warn { color: var(--warn); }
.kpi-delta .material-symbols-outlined { font-size: 13px; }
.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex; flex-direction: column;
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  background: rgba(255,255,255,0.015);
}
.panel-head h3 {
  font-size: 13px; font-weight: 600; letter-spacing: -0.2px;
  color: var(--text);
}
.chip {
  display: inline-flex; align-items: center;
  height: 22px; padding: 0 10px;
  border: 1px solid var(--border);
  background: var(--surface-hover);
  border-radius: 11px;
  font-size: 11px; color: var(--text-muted); font-weight: 500;
}
.panel-body { flex: 1; padding: 18px; min-height: 200px; position: relative; }
.chart { width: 100%; height: 140px; display: block; }
.table-search {
  margin: 14px 18px;
  display: flex; align-items: center; gap: 8px;
  position: relative;
}
.table-search .material-symbols-outlined { font-size: 16px; color: var(--text-dim); }
.table-search input {
  flex: 1; height: 32px;
  border: 1px solid var(--border);
  background: var(--surface-hover);
  color: var(--text);
  border-radius: 6px;
  padding: 0 10px; padding-left: 30px;
  font-size: 12px; font-family: inherit;
  outline: none;
}
.table-search input::placeholder { color: var(--text-dim); }
.table-search input:focus { border-color: var(--accent); }
.table-wrap { overflow-x: auto; border-top: 1px solid var(--border); }
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.data-table th {
  text-align: left;
  padding: 12px 16px;
  color: var(--text-muted);
  font-weight: 600;
  font-size: 11px; letter-spacing: 0.4px; text-transform: uppercase;
  border-bottom: 1px solid var(--border);
  background: rgba(255,255,255,0.015);
  white-space: nowrap;
}
.data-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  color: var(--text);
  vertical-align: middle;
  white-space: nowrap;
}
.data-table tr:last-child td { border-bottom: none; }
.data-table tr:hover { background: rgba(255,255,255,0.02); }
.status-badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 2px 8px; border-radius: 10px;
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px;
}
.status-badge.ok { background: rgba(16,185,129,0.12); color: var(--ok); border: 1px solid rgba(16,185,129,0.2); }
.status-badge.err { background: rgba(244,114,182,0.12); color: var(--err); border: 1px solid rgba(244,114,182,0.2); }
.status-badge.warn { background: rgba(245,158,11,0.12); color: var(--warn); border: 1px solid rgba(245,158,11,0.2); }
.mono { font-family: 'JetBrains Mono', monospace; font-size: 11px; }
.foot {
  height: 40px;
  padding: 0 24px;
  display: flex; align-items: center; justify-content: space-between;
  border-top: 1px solid var(--border);
  background: var(--surface);
  flex-shrink: 0;
}
.foot-left { display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--text-muted); }
.divider { color: var(--text-dim); }
.foot-right { font-size: 11px; color: var(--text-muted); font-weight: 500; }
.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  height: 100%; color: var(--text-muted); gap: 8px;
}
.empty-state .material-symbols-outlined { font-size: 40px; color: var(--text-dim); }
@media (max-width: 768px) {
  main { padding: 12px; }
  .bar { padding: 0 12px; }
  .foot { padding: 0 12px; }
  .kpi-row, .charts-row { grid-template-columns: 1fr; }
  .actions .select { display: none; }
}
