/* ===== Loom Dashboard v3 — glassmorphism ===== */
:root{
  --bg:#060912;
  --bg2:#0a0f1c;
  --surface:rgba(16,22,38,0.72);
  --surface2:rgba(22,30,50,0.55);
  --surface3:rgba(28,38,62,0.40);
  --border:rgba(124,168,220,0.13);
  --border2:rgba(124,168,220,0.22);
  --text:#e9eef7;
  --text-muted:#8a96ad;
  --text-dim:#56627a;
  --accent:#38bdf8;      /* sky */
  --accent2:#a78bfa;     /* violet */
  --ok:#34d399;
  --warn:#fbbf24;
  --err:#fb7185;
  --info:#22d3ee;
  --rose:#fb7185;
  --r:16px;
  --r-sm:10px;
  --shadow:0 8px 32px -12px rgba(0,0,0,.6);
  --glass:blur(18px) saturate(140%);
  --t:160ms cubic-bezier(.2,.7,.3,1);
  --font-sans:'Inter',system-ui,-apple-system,sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:var(--font-sans);
  background:
    radial-gradient(1200px 800px at 100% -10%, rgba(56,189,248,.07), transparent 60%),
    radial-gradient(900px 700px at -10% 110%, rgba(167,139,250,.06), transparent 60%),
    linear-gradient(180deg,#060912,#0a0f1c 40%,#070b16);
  color:var(--text);font-size:13px;line-height:1.5;
  -webkit-font-smoothing:antialiased;overflow:hidden;
}
.mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums}
.divider{color:var(--text-dim)}

/* ambient orbs */
.orb{position:fixed;border-radius:50%;filter:blur(90px);opacity:.10;pointer-events:none;z-index:0}
.orb-1{width:520px;height:520px;background:#38bdf8;top:-180px;right:-120px;animation:float1 18s ease-in-out infinite}
.orb-2{width:460px;height:460px;background:#a78bfa;bottom:-160px;left:18%;animation:float2 22s ease-in-out infinite}
.orb-3{width:380px;height:380px;background:#22d3ee;top:40%;left:-140px;animation:float1 26s ease-in-out infinite}
@keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(30px,-24px)}}
@keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(-26px,22px)}}

/* ===== shell ===== */
.shell{display:flex;height:100vh;position:relative;z-index:1}

/* ===== sidebar ===== */
.sidebar{
  width:248px;flex-shrink:0;display:flex;flex-direction:column;
  background:var(--surface);backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
  border-right:1px solid var(--border);padding:20px 16px;
}
.brand{display:flex;align-items:center;gap:12px;padding:4px 6px 22px}
.mark{
  width:36px;height:36px;border-radius:11px;
  background:linear-gradient(135deg,#38bdf8,#a78bfa);
  display:grid;place-items:center;box-shadow:0 4px 14px -2px rgba(56,189,248,.45)
}
.brand-name{font-weight:700;font-size:16px;letter-spacing:-.3px}
.brand-sub{font-size:10.5px;color:var(--text-muted);letter-spacing:.5px;text-transform:uppercase}

.nav{display:flex;flex-direction:column;gap:3px;margin-bottom:18px}
.nav-item{
  display:flex;align-items:center;gap:11px;width:100%;text-align:left;
  padding:10px 12px;border:1px solid transparent;border-radius:11px;
  background:transparent;color:var(--text-muted);font-family:inherit;font-size:13px;font-weight:500;
  cursor:pointer;transition:all var(--t);
}
.nav-item:hover{background:var(--surface3);color:var(--text)}
.nav-item.active{
  background:linear-gradient(135deg,rgba(56,189,248,.14),rgba(167,139,250,.10));
  color:var(--text);border-color:var(--border2);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05)
}
.nav-ico{width:18px;text-align:center;font-size:14px;opacity:.9}
.nav-item.active .nav-ico{color:var(--accent)}

.side-status{
  margin-top:auto;margin-bottom:14px;padding:14px;border-radius:13px;
  background:var(--surface2);border:1px solid var(--border);
}
.ss-row{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;margin-bottom:10px}
.ss-dot{width:8px;height:8px;border-radius:50%;background:var(--warn);box-shadow:0 0 8px currentColor}
.ss-dot.live{background:var(--ok)}
.ss-dot.dead{background:var(--err)}
.ss-meta{display:flex;flex-direction:column;gap:4px}
.ss-meta>div{display:flex;justify-content:space-between;align-items:center;font-size:10.5px}
.ss-k{color:var(--text-dim);text-transform:uppercase;letter-spacing:.4px}
.ss-v{color:var(--text-muted);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.side-actions{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.side-btn{
  display:flex;align-items:center;gap:10px;width:100%;text-align:left;
  padding:9px 12px;border:1px solid var(--border);border-radius:11px;
  background:var(--surface2);color:var(--text-muted);font-family:inherit;font-size:12.5px;font-weight:500;
  cursor:pointer;transition:all var(--t);
}
.side-btn:hover{background:var(--surface3);color:var(--text);border-color:var(--border2);transform:translateX(2px)}
.side-btn:active{transform:translateX(0) scale(.98)}
.sb-ico{font-size:14px;width:16px;text-align:center}
.side-foot{font-size:10px;color:var(--text-dim);text-align:center;letter-spacing:.4px}

/* ===== main ===== */
.main{flex:1;display:flex;flex-direction:column;min-width:0}
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 28px 16px;border-bottom:1px solid var(--border);flex-shrink:0;
}
.tb-title{font-size:22px;font-weight:700;letter-spacing:-.5px}
.tb-sub{font-size:12px;color:var(--text-muted);margin-left:10px}
.tb-right{display:flex;align-items:center;gap:10px}
.pill{
  display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 12px;border-radius:13px;
  font-size:11.5px;font-weight:600;letter-spacing:.3px;
  background:rgba(52,211,153,.12);color:var(--ok);border:1px solid rgba(52,211,153,.28);
}
.pill-dot{width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor;animation:pulse 1.6s ease-in-out infinite}
.pill.dead{background:rgba(251,113,133,.12);color:var(--err);border-color:rgba(251,113,133,.28)}
.pill.dead .pill-dot{animation:none}
.pill.warn{background:rgba(251,191,36,.12);color:var(--warn);border-color:rgba(251,191,36,.28)}
.pill-quiet{background:var(--surface2);color:var(--text-muted);border-color:var(--border)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}

.content{flex:1;overflow-y:auto;padding:24px 28px}
.view{display:none;flex-direction:column;gap:18px}
.view-active{display:flex;animation:fade .35s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media(max-width:1080px){.grid-2{grid-template-columns:1fr}}

/* ===== kpi cards ===== */
.kpi-card{
  position:relative;overflow:hidden;padding:16px 18px;border-radius:var(--r);
  background:var(--surface);backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
  border:1px solid var(--border);
}
.kpi-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.04),transparent 60%);pointer-events:none}
.kpi-card .kc-glow{position:absolute;left:0;top:0;width:3px;height:100%;border-radius:0 3px 3px 0}
.kpi-label{font-size:10.5px;font-weight:600;letter-spacing:.6px;color:var(--text-muted);text-transform:uppercase;margin-bottom:8px}
.kpi-value{font-family:var(--font-mono);font-size:24px;font-weight:700;line-height:1.05}
.kpi-sub{font-size:10.5px;color:var(--text-dim);margin-top:6px}

/* ===== panel ===== */
.panel{
  background:var(--surface);backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
  border:1px solid var(--border);border-radius:var(--r);overflow:hidden;
  box-shadow:var(--shadow);display:flex;flex-direction:column;
}
.panel-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 18px;border-bottom:1px solid var(--border);
  background:linear-gradient(180deg,rgba(255,255,255,.025),transparent)
}
.panel-head h3{font-size:13px;font-weight:600;letter-spacing:-.2px}
.ph-sub{font-size:11px;color:var(--text-dim);font-weight:400;margin-left:6px}
.chip{
  display:inline-flex;align-items:center;height:22px;padding:0 10px;border-radius:11px;
  background:var(--surface2);border:1px solid var(--border);font-size:11px;color:var(--text-muted);font-weight:500
}
.panel-body{flex:1;padding:14px;min-height:220px;position:relative}
.cv{width:100%;height:240px;display:block}

/* ===== search ===== */
.search{position:relative;display:flex;align-items:center}
.search-ico{position:absolute;left:10px;font-size:13px;color:var(--text-dim);pointer-events:none}
.search input{
  width:230px;height:30px;padding:0 10px 0 28px;border:1px solid var(--border);border-radius:9px;
  background:var(--surface2);color:var(--text);font-family:inherit;font-size:12px;outline:none;transition:all var(--t)
}
.search input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(56,189,248,.12)}
.search input::placeholder{color:var(--text-dim)}

/* ===== table ===== */
.table-wrap{overflow:auto;border-top:1px solid var(--border);max-height:420px}
.table-wrap.tall{max-height:520px}
.data-table{width:100%;border-collapse:collapse;font-size:12px}
.data-table th{
  text-align:left;padding:11px 16px;color:var(--text-muted);font-weight:600;font-size:10.5px;
  letter-spacing:.5px;text-transform:uppercase;border-bottom:1px solid var(--border);
  background:rgba(255,255,255,.015);position:sticky;top:0;backdrop-filter:blur(6px)
}
.data-table td{padding:11px 16px;border-bottom:1px solid var(--border);color:var(--text);white-space:nowrap}
.data-table tr:last-child td{border-bottom:none}
.data-table tbody tr{transition:background var(--t)}
.data-table tbody tr:hover{background:rgba(56,189,248,.05)}
.tag{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:11px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.3px}
.tag.ok{background:rgba(52,211,153,.13);color:var(--ok);border:1px solid rgba(52,211,153,.25)}
.tag.err{background:rgba(251,113,133,.13);color:var(--err);border:1px solid rgba(251,113,133,.25)}
.tag.warn{background:rgba(251,191,36,.13);color:var(--warn);border:1px solid rgba(251,191,36,.25)}
.bar-cell{display:flex;align-items:center;gap:8px}
.mini-bar{flex:1;height:6px;border-radius:3px;background:var(--surface3);overflow:hidden;max-width:90px}
.mini-bar>span{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:3px}

/* ===== foot ===== */
.foot{
  height:38px;display:flex;align-items:center;gap:10px;padding:0 28px;flex-shrink:0;
  border-top:1px solid var(--border);background:var(--surface);backdrop-filter:var(--glass);
  font-size:11px;color:var(--text-muted)
}
.foot-spacer{flex:1}

/* ===== toast ===== */
.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);
  padding:11px 18px;border-radius:12px;background:var(--surface);backdrop-filter:var(--glass);
  border:1px solid var(--border2);font-size:12.5px;font-weight:500;color:var(--text);
  box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:all .3s ease;z-index:50
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* scrollbars */
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(124,168,220,.18);border-radius:5px}
::-webkit-scrollbar-thumb:hover{background:rgba(124,168,220,.32)}

@media(max-width:768px){
  .sidebar{width:64px;padding:14px 8px}
  .brand-txt,.nav-item span:not(.nav-ico),.side-status,.side-btn span:not(.sb-ico),.side-foot{display:none}
  .content{padding:16px}
  .topbar{padding:14px 16px}
}
